# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file.

APP_NAME=Early Intervention Decision-Support API
APP_ENV=development

# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://ei_user:YourPassword@localhost:5432/early_intervention

# Used only by the test suite
TEST_DATABASE_URL=postgresql+psycopg://ei_user:YourPassword@localhost:5432/early_intervention_test

# Signing key for login tokens, at least 32 characters.
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-generated-secret-of-at-least-32-characters

# How long a login stays valid, in minutes (5 to 1440).
ACCESS_TOKEN_MINUTES=60